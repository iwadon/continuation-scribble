builddir = build

cc = m68k-xelf-gcc
cflags = -Wall -Wextra -O0
as = ../x68k/eh68.2/build/src/eh68 run ../x68k/human68k/opt/bin/has060x.x --
asflags =
ld = $cc
ldflags =
libs =

rule CC
  command = $cc $cflags -c -o $out $in
rule AS
  command = $as $asflags -o $out $in
rule ELF
  command = x68k2elf.py $in $out
rule LD
  command = $ld $ldflags -o $out $in $libs

build $builddir/m68k_ctx_test: LD $builddir/m68k_ctx_test.o $builddir/m68k_ctx.o.elf
build $builddir/m68k_ctx_test.o: CC m68k_ctx_test.c
build $builddir/m68k_ctx.o.elf: ELF $builddir/m68k_ctx.o
build $builddir/m68k_ctx.o: AS m68k_ctx.s

build $builddir/cont_test: LD $builddir/cont_test.o $builddir/cont.o $builddir/m68k_ctx.o.elf
build $builddir/cont_test.o: CC cont_test.c
build $builddir/cont.o: CC cont.c

build $builddir/cont_clone_test: LD $builddir/cont_clone_test.o $builddir/cont.o $builddir/m68k_ctx.o.elf
build $builddir/cont_clone_test.o: CC cont_clone_test.c

build $builddir/fiber_test: LD $builddir/fiber_test.o $builddir/fiber.o $builddir/fiber_trampoline.o.elf $builddir/m68k_ctx.o.elf $builddir/scheduler.o
build $builddir/fiber_test.o: CC fiber_test.c
build $builddir/fiber.o: CC fiber.c
build $builddir/fiber_trampoline.o.elf: ELF $builddir/fiber_trampoline.o
build $builddir/fiber_trampoline.o: AS fiber_trampoline.s
build $builddir/scheduler.o: CC scheduler.c
