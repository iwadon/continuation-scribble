builddir = ../build/arm64-apple

cc = gcc
cflags = -Wall -Wextra -O0 -I .
as = gcc
asflags = $cflags -c
ld = $cc
ldflags =
libs =

rule CC
  command = $cc $cflags -c -o $out $in
rule AS
  command = $as $asflags -o $out $in
rule LD
  command = $ld $ldflags -o $out $in $libs

build $builddir/arm64_ctx_test: LD $builddir/arm64_ctx_test.o $builddir/arm64_ctx.o
build $builddir/arm64_ctx_test.o: CC arm64_ctx_test.c
build $builddir/arm64_ctx.o: AS arm64_ctx.s

build $builddir/fiber_test.x: LD $builddir/fiber_test.o $builddir/fiber.o $builddir/fiber_trampoline.o $builddir/arm64_ctx.o $builddir/scheduler.o
build $builddir/fiber_test.o: CC ../fiber_test.c
build $builddir/fiber.o: CC ../fiber.c
build $builddir/fiber_trampoline.o: AS fiber_trampoline.s
build $builddir/scheduler.o: CC ../scheduler.c
